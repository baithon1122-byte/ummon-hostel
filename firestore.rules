rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'baithon1122@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isStaffOrAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
      );
    }

    // Admins registry
    match /admins/{adminUid} {
      allow read: if isStaffOrAdmin();
      allow write: if isSuperAdmin();
    }

    // Staff registry
    match /staff/{staffId} {
      allow read: if isStaffOrAdmin();
      allow write: if isSuperAdmin();
    }

    // Rooms
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // Bookings
    match /bookings/{bookingId} {
      allow read: if isStaffOrAdmin();
      allow create: if (
        // Public booking creation with strict integrity
        request.resource.data.guestName is string &&
        request.resource.data.guestName.size() >= 2 &&
        request.resource.data.guestName.size() <= 120 &&
        request.resource.data.guestEmail is string &&
        request.resource.data.guestEmail.size() <= 150 &&
        request.resource.data.guestPhone is string &&
        request.resource.data.guestPhone.size() <= 40 &&
        request.resource.data.roomTypeId is string &&
        request.resource.data.checkInDate is string &&
        request.resource.data.checkOutDate is string &&
        request.resource.data.nights is number &&
        request.resource.data.nights >= 1 &&
        request.resource.data.guestsCount is number &&
        request.resource.data.guestsCount >= 1 &&
        request.resource.data.status in ['pending', 'confirmed']
      ) || isStaffOrAdmin();
      allow update, delete: if isStaffOrAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if (resource.data.isApproved == true) || isStaffOrAdmin();
      allow create: if (
        request.resource.data.guestName is string &&
        request.resource.data.guestName.size() <= 100 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() <= 1000 &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.isApproved == false
      ) || isStaffOrAdmin();
      allow update, delete: if isStaffOrAdmin();
    }

    // Messages (inquiries)
    match /messages/{messageId} {
      allow read: if isStaffOrAdmin();
      allow create: if (
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 120 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 2000 &&
        request.resource.data.isRead == false
      ) || isStaffOrAdmin();
      allow update, delete: if isStaffOrAdmin();
    }

    // General website & hostel settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // Gallery
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read, write: if isStaffOrAdmin();
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read, write: if isStaffOrAdmin();
    }

    // Activity Logs
    match /activityLogs/{logId} {
      allow read, write: if isStaffOrAdmin();
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }
  }
}
